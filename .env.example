# Copiar a .env.local (local) y cargar las mismas variables en Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. NUNCA con prefijo NEXT_PUBLIC_. Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Opcionales
GEMINI_MODEL=gemini-3.8-flash
# Respaldo: si Gemini está saturado, la app usa Claude (consola de desarrolladores, se paga por uso aparte del plan Pro).
ANTHROPIC_API_KEY=
CLAUDE_FALLBACK_MODEL=claude-sonnet-5-5
# Emails admin adicionales (separados por coma). Ya incluye los dos del código.
ADMIN_EMAILS=# Correos de avisos y resumen semanal (Resend.com). Sin esta clave no se envía nada.
RESEND_API_KEY=
# Remitente (el dominio tiene que estar verificado en Resend).
DIGEST_FROM=DRM-IA Finanzas <avisos@drm-ia.com>
# Clave que Vercel Cron manda al llamar /api/cron/digest. Inventá una larga y aleatoria; también firma los links de baja.
CRON_SECRET=
